; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

warnings/check_invalid_track_paths=false
compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Pizza Boy"
config/version="0.01"
run/main_scene="uid://bdjhxs02iqaue"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=120
config/icon="res://icon.svg"

[autoload]

GlobalSignal="*res://scripts/global_signal.gd"
GlobalVar="*res://scripts/global_var.gd"
GlobalMarker="*res://environment/global_markers.gd"
BackgroundMusic="*res://scripts/background_music.gd"

[display]

window/stretch/mode="canvas_items"
window/vsync/vsync_mode=2

[global_group]

enemies=""
items=""
player=""
nav_road=""
static=""
thief_target=""
thief=""
placement=""
placement_system=""
quest_log=""
cash_register=""

[gui]

theme/default_font_multichannel_signed_distance_field=true

