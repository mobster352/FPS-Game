[layer_names]

3d_physics/layer_1="Environment"
3d_navigation/layer_1="Sidewalk"
3d_physics/layer_2="Player"
3d_navigation/layer_2="Restaurant"
3d_physics/layer_3="Enemies"
3d_navigation/layer_3="Road"
3d_physics/layer_4="Items"
3d_navigation/layer_4="Back Restaurant"
3d_physics/layer_5="Detection"
3d_physics/layer_6="Customer"
3d_physics/layer_7="Static"
3d_physics/layer_8="Movable"

[physics]

common/physics_ticks_per_second=120
common/physics_jitter_fix=0.0
3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
occlusion_culling/use_occlusion_culling=true
